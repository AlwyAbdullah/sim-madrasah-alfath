# ===== Backend production (.env) =====
APP_PORT=8080
APP_ENV=production

# Same-origin via Nginx → boleh diisi domain (CORS jadi tidak relevan saat same-origin)
CORS_ORIGIN=https://madrasah.example.com

# Database (buat user khusus, JANGAN pakai root di produksi)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sim_user
DB_PASSWORD=ISI_PASSWORD_KUAT
DB_NAME=sim_madrasah

# JWT — WAJIB ganti: hasil dari `openssl rand -hex 32`
JWT_SECRET=GANTI_DENGAN_HEX_ACAK_64_KARAKTER
JWT_EXPIRY_MINUTES=120

# WAJIB true di HTTPS agar cookie aman
COOKIE_SECURE=true

# Telegram — satu-satunya kanal notifikasi. Token dari @BotFather.
# JANGAN di-commit; file .env produksi wajib chmod 600.
# Tujuan chat/grup diatur dari halaman admin Notifikasi, bukan di sini.
TELEGRAM_BOT_TOKEN=GANTI_DENGAN_TOKEN_DARI_BOTFATHER

# Irama worker pengirim antrean notifikasi.
NOTIF_POLL_SECONDS=60
NOTIF_SEND_DELAY_SECONDS=3
NOTIF_BATCH_LIMIT=20
