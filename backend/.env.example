# Server
# APP_HOST bawaannya 127.0.0.1 — backend selalu diakses lewat nginx.
# Isi 0.0.0.0 HANYA bila memang perlu dihubungi dari mesin lain.
APP_HOST=127.0.0.1
APP_PORT=8080
APP_ENV=development

# CORS — origin frontend Next.js
CORS_ORIGIN=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sim_madrasah

# JWT
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRY_MINUTES=60

# Cookie (set true di produksi dengan HTTPS)
COOKIE_SECURE=false

# Telegram — satu-satunya kanal notifikasi. Token dari @BotFather.
# Kosong = pengirim tidak aktif (pesan tetap mengantre di tabel `notifikasi`).
# Tujuan chat/grup TIDAK diatur di sini, melainkan dari halaman admin Notifikasi.
TELEGRAM_BOT_TOKEN=

# Irama worker pengirim antrean notifikasi.
NOTIF_POLL_SECONDS=60
NOTIF_SEND_DELAY_SECONDS=3
NOTIF_BATCH_LIMIT=20
