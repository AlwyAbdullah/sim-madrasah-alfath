# Server
APP_PORT=8080
APP_ENV=development

# CORS — origin frontend Next.js
CORS_ORIGIN=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sim_madrasah

# JWT
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRY_MINUTES=60

# Cookie (set true di produksi dengan HTTPS)
COOKIE_SECURE=false

# Secret bersama untuk endpoint /auth/bot-login (dipakai n8n). Kosong = bot-login dimatikan.
BOT_SHARED_SECRET=

# Worker pengirim notifikasi WhatsApp bawaan (opsional).
# Kosong = worker tidak aktif; endpoint /notifikasi/pending & /notifikasi/status
# tetap bisa dipakai n8n/skrip lain sebagai gantinya.
WAHA_URL=
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_POLL_SECONDS=60
WAHA_SEND_DELAY_SECONDS=8
WAHA_BATCH_LIMIT=20
