{
  "name": "Notifikasi WA Madrasah Al Fath",
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "minutes", "minutesInterval": 5 } ] }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Setiap 5 Menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-360, 300]
    },
    {
      "parameters": {
        "url": "https://madrasah-alfath-malang.web.id/api/v1/notifikasi/pending?limit=20",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Bot-Secret", "value": "__BOT_SECRET__" }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Ambil Antrean",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-140, 300]
    },
    {
      "parameters": { "fieldToSplitOut": "items", "options": {} },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Pecah Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [80, 300]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Loop Antrean",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "__WAHA_URL__/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Api-Key", "value": "__WAHA_API_KEY__" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: 'default', chatId: $json.tujuan + '@c.us', text: $json.pesan }) }}",
        "options": { "timeout": 20000 }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Kirim WAHA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://madrasah-alfath-malang.web.id/api/v1/notifikasi/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Bot-Secret", "value": "__BOT_SECRET__" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Loop Antrean').item.json.id, sukses: true }) }}",
        "options": { "timeout": 15000 }
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Lapor Sukses",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://madrasah-alfath-malang.web.id/api/v1/notifikasi/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Bot-Secret", "value": "__BOT_SECRET__" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Loop Antrean').item.json.id, sukses: false, catatan: String($json.error?.message || $json.error || 'gagal kirim').slice(0, 200) }) }}",
        "options": { "timeout": 15000 }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Lapor Gagal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 420]
    },
    {
      "parameters": { "amount": 8, "unit": "seconds" },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Jeda 8 Detik",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1020, 300],
      "webhookId": "b2000000-0000-4000-8000-000000000008"
    }
  ],
  "connections": {
    "Setiap 5 Menit": {
      "main": [ [ { "node": "Ambil Antrean", "type": "main", "index": 0 } ] ]
    },
    "Ambil Antrean": {
      "main": [ [ { "node": "Pecah Items", "type": "main", "index": 0 } ] ]
    },
    "Pecah Items": {
      "main": [ [ { "node": "Loop Antrean", "type": "main", "index": 0 } ] ]
    },
    "Loop Antrean": {
      "main": [
        [],
        [ { "node": "Kirim WAHA", "type": "main", "index": 0 } ]
      ]
    },
    "Kirim WAHA": {
      "main": [
        [ { "node": "Lapor Sukses", "type": "main", "index": 0 } ],
        [ { "node": "Lapor Gagal", "type": "main", "index": 0 } ]
      ]
    },
    "Lapor Sukses": {
      "main": [ [ { "node": "Jeda 8 Detik", "type": "main", "index": 0 } ] ]
    },
    "Lapor Gagal": {
      "main": [ [ { "node": "Jeda 8 Detik", "type": "main", "index": 0 } ] ]
    },
    "Jeda 8 Detik": {
      "main": [ [ { "node": "Loop Antrean", "type": "main", "index": 0 } ] ]
    }
  }
}
